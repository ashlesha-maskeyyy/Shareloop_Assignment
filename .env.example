# Copy to .env for local development. On Vercel, set these in
# Project > Settings > Environment Variables (never commit real values).

# Required on Vercel. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres connection string. Added automatically when you connect Neon in Vercel's Storage tab.
# Leave empty locally to use SQLite (shareloop.db).
DATABASE_URL=

# Photo uploads. Added automatically when you connect a Vercel Blob store (public access).
# Leave empty locally to save photos in public/static/uploads/.
BLOB_READ_WRITE_TOKEN=

# Optional: password-reset emails (Gmail needs an App Password, not your normal password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
